# --- Virtual environment ---
.venv/
venv/
env/
ENV/

# --- Secrets / local config ---
.env
.env.*
!.env.example

# --- Python bytecode / cache ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Packaging / build artifacts ---
build/
dist/
*.egg-info/
.eggs/

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache

# --- Type checkers / linters ---
.mypy_cache/
.ruff_cache/
.pytype/

# --- Jupyter (if used for exploration) ---
.ipynb_checkpoints/

# --- IDE / editor ---
.vscode/
.idea/
*.swp

# --- OS-specific ---
.DS_Store
Thumbs.db

# --- Claude Code local settings ---
.claude/settings.local.json

# --- Evals run output (timestamped artifacts, not source) ---
evals/results/*.csv
!evals/results/.gitkeep
