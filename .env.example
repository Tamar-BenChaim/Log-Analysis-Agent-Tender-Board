# Copy this file to `.env` and fill in the real values.
#   cp .env.example .env        (bash/Git Bash)
#   copy .env.example .env      (Windows cmd)
# `.env` itself is git-ignored - never commit real credentials.

# --- MongoDB connection (required) ---
# Atlas connection string. Get it from Atlas: Database -> Connect -> Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/?appName=Cluster0

# Database and collection that hold the Tender Board activity logs.
# In this project, the logs live in a shared, whole-application winston
# log collection (not a dedicated Tender-Board-only collection).
MONGODB_DB_NAME=test
MONGODB_COLLECTION_NAME=applicationlogs

# Name of the field inside each log document that stores the event
# timestamp - used to filter by date range.
MONGODB_DATE_FIELD=timestamp

# Case-insensitive keyword used to recognize Tender-Board-related log
# lines inside the shared applicationlogs collection. This is the
# fallback signal for pre-enrichment logs that don't have `module` yet.
MONGODB_TENDER_KEYWORD=tender

# Value of the enriched `module` field that identifies a Tender-Board
# log line (SCRUM-161). Used together with MONGODB_TENDER_KEYWORD above -
# a record matching either one is fetched.
MONGODB_TENDER_BOARD_MODULE=tenderBoard

# --- OpenAI API key (required for `report`'s analyze_node AND `chat`) ---
# report mode: one call per run (agent/nodes/analyze.py, SCRUM-180).
# chat mode: one call per turn to pick tools/compose answers (SCRUM-174).
OPENAI_API_KEY=sk-...

# Only set this to true/1/yes if you're on a network that does TLS
# interception and breaks certificate verification for outbound HTTPS
# (the same class of issue the Node/Express backend already works
# around via its own NODE_TLS_REJECT_UNAUTHORIZED=0 below). Leave unset
# everywhere else - it disables certificate verification for this
# agent's OpenAI calls, which is not something to turn on by default.
OPENAI_DISABLE_SSL_VERIFY=false

# Only relevant if the Node/Express backend itself runs on a machine
# with the same TLS-interception issue - has no effect on this Python
# agent, kept here only because it's the same root cause/symptom.
NODE_TLS_REJECT_UNAUTHORIZED=1
